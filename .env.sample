GA_ID=ekekkng
# Virus scanner backend (FastAPI orchestrator). See docs/virus-scanner-ui.md.
# Local dev: http://localhost:8080   Prod: https://scan-api.arithmiks.com
GATSBY_SCANNER_API_URL=http://localhost:8080

# Required by src/api/form-submission (the contact form's Gatsby Function) to
# send the confirmation email via Gmail SMTP. Server-only — no GATSBY_ prefix,
# so this never reaches the browser bundle. Without these the form fails fast
# with a 500 "Server configuration error" instead of sending mail.
# GMAIL_SMTP_PASS must be a Google App Password (requires 2-Step Verification
# on the account), not the account's normal login password.
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
SERVICE_EMAIL=
