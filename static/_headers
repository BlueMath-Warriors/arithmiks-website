# Files copied as-is from /static keep their names when they change, so they can't
# be cached "forever" the way Gatsby's hashed bundles are. One day with a week of
# stale-while-revalidate means repeat visits skip the network round-trip and
# edits still show up within a day.
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.woff2
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Gatsby's content-hashed assets stay immutable; listed last so it wins over the
# extension rules above for /static/*.
/static/*
  Cache-Control: public, max-age=31536000, immutable
